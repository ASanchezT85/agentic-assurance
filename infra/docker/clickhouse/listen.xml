<clickhouse>
    <!-- The stock image ships docker_related_config.xml with <listen_host>::</listen_host>.
         On Docker hosts with IPv6 disabled (common on Windows and on GitHub Actions
         runners) that bind fails. replace="replace" swaps the entry instead of adding
         a second one, which would make ClickHouse try to bind every port twice and
         fail with "Address already in use". -->
    <listen_host replace="replace">0.0.0.0</listen_host>
</clickhouse>
