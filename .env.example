# Development-only, non-secret defaults. Matches docker-compose.yml.
# Production credentials MUST come from a secret manager / KMS (spec 35).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assurance
POSTGRES_USER=assurance
POSTGRES_PASSWORD=assurance_dev_only

CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=assurance
CLICKHOUSE_USER=assurance
CLICKHOUSE_PASSWORD=assurance_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222

GATEWAY_ADDR=:8080
FLEET_ENGINE_ADDR=:8081

# No broker credentials in Phase 0. Real-money execution is not supported.
