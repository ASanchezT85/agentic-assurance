# Development-only, non-secret defaults. Matches docker-compose.yml.
# Production credentials MUST come from a secret manager / KMS (spec 35).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=assurance
POSTGRES_USER=assurance
POSTGRES_PASSWORD=assurance_dev_only

CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=assurance
CLICKHOUSE_USER=assurance
CLICKHOUSE_PASSWORD=assurance_dev_only

REDIS_HOST=localhost
REDIS_PORT=6379

NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222

GATEWAY_ADDR=:8080
FLEET_ENGINE_ADDR=:8081

# No broker credentials in Phase 0. Real-money execution is not supported.

# The application connects as a non-superuser so row level security actually applies
# (see migrations/postgres/0001_authority.sql). Migrations run as POSTGRES_USER.
POSTGRES_APP_DSN=postgres://assurance_app:assurance_app_dev_only@localhost:5432/assurance?sslmode=disable

# Connections in the gateway pool. pgxpool defaults to four per CPU, which is where a
# thousand concurrent agents queue: a load run measured 232 intents/s on the default
# against 422/s with fifty. A DSN that sets pool_max_conns itself wins over this.
POSTGRES_MAX_CONNS=50

# Market data for the participation component of the Fleet Risk Vector (ADR-019).
# Optional: without it P is UNKNOWN, which is the correct outcome rather than a
# degraded one. Leave empty here; the real value belongs in the environment or a
# secret manager and never in this file.
ALPHAVANTAGE_API_KEY=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Every endpoint that carries tenant data authenticates, and the tenant comes from
# the credential rather than from a header or a body field (ADR-025, INV-007).
# Format: identity@tenant=token,identity@tenant=token. A credential without a tenant
# is refused at startup; tokens shorter than 32 characters are too.
#
# A caller that legitimately acts for several tenants needs several credentials.
GATEWAY_API_CREDENTIALS=svc_local@tenant_local=replace-me-with-32-plus-characters_dev_only
INTELLIGENCE_API_CREDENTIALS=svc_reader@tenant_local=replace-me-with-32-plus-characters_dev_only

# The console reads through the same credential registry. Server-side only: a token
# in a client bundle is a token published, which is why this is not NEXT_PUBLIC_.
CONSOLE_API_TOKEN=replace-me-with-32-plus-characters_dev_only
GATEWAY_URL=http://localhost:8080
FLEET_ENGINE_URL=http://localhost:8081

# ---------------------------------------------------------------------------
# The enforcement path
# ---------------------------------------------------------------------------
# Without any one of these POST /v1/intents is absent rather than failing, and the
# startup log names which is missing.
CLICKHOUSE_HTTP_URL=http://localhost:8123
POLICY_PUBLIC_KEY=
POLICY_BUNDLE_DIR=./local/policy
INSTRUMENT_SYMBOLS=./local/instruments.json

# alpaca, tradier, or fake. Both real adapters refuse a non-paper endpoint
# themselves; fake additionally requires ASSURANCE_ENV=development, because a
# production gateway pointed at a fake venue accepts every order and sends none.
BROKER=fake
ASSURANCE_ENV=development

# Broker credentials are deliberately NOT in this file, and tests/scope_guard_test.go
# enforces that. An example file with a slot for a venue secret is an invitation to
# paste a live one into the working tree. They are documented in
# docs/operations/README.md and belong in a secret manager (spec section 35).

# Optional. Without a trust bundle an SVID cannot be verified, so callers reach A1
# at best; that is a stated degradation, not a failure.
SPIFFE_TRUST_BUNDLE=
SPIFFE_TRUST_DOMAIN=

# ---------------------------------------------------------------------------
# The intelligence plane
# ---------------------------------------------------------------------------
# Without cohorts nothing is measured and the API serves only what is already stored.
FLEET_COHORT_TENANTS=tenant_local
FLEET_WINDOW=1m
FLEET_LAG=15s

# The Digital Twin is a Python process. The project interpreter is created by
# `make bootstrap`.
SIMULATOR_PYTHON=.venv/bin/python
SIMULATOR_REPO=.
SIMULATOR_SCENARIO_DIR=simulator/scenarios
SIMULATION_TIMEOUT=5m
SIMULATION_CONCURRENCY=2
SIMULATION_WATCHDOG=2s

# Which tenant each verified workload acts for. Without an entry an SVID establishes
# a workload and no customer, and the request is refused naming the missing one.
# Format: spiffe://domain/path=tenant. A path ending in "/" matches everything
# beneath it; the trailing slash is required so /ns/prod does not also match
# /ns/production. A whole trust domain is refused: it is not a tenant.
SPIFFE_WORKLOADS=spiffe://acme.example/ns/agents/=tenant_local

# Which identities may issue authority grants. Comma-separated, and deliberately
# separate from the credential itself: a credential that could both submit intents and
# issue the authority to submit them would let an agent raise its own ceiling (P-002).
# Empty means nobody can, and POST /v1/authority-grants answers 403 for everyone.
GATEWAY_GRANT_ISSUERS=
